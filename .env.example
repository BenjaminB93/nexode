# Copier en .env (jamais commité) et remplir.

# Jeton « API Read Access Token » TMDB (themoviedb.org › Paramètres › API).
TMDB_READ_TOKEN=

# Notifications (Web Push) : clés VAPID générées une fois par « node src/cli/vapid-keys.ts ». Vides = pas de notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact transmis aux services push (https:// ou mailto:). Vide = SITE_URL s'il est en https.
VAPID_SUBJECT=

# Adresse d'écoute. 127.0.0.1 par défaut ; 0.0.0.0 pour tester depuis le téléphone sur le réseau local.
HOST=127.0.0.1
PORT=3000

# Fichier SQLite.
DB_PATH=data/app.sqlite

# development | production | test. production sur le Pi : cookie Secure, seule SITE_URL acceptée comme origine.
# (Le cookie est aussi Secure dès que SITE_URL est en https.)
NODE_ENV=development

# Adresse publique du site, sans « / » final : base des liens d'invitation et de réinitialisation,
# et seule origine acceptée pour les écritures en production.
SITE_URL=http://localhost:3000

# 1 derrière Caddy : l'adresse du client (limitation des tentatives de connexion) est lue dans X-Forwarded-For.
# Laisser vide sans reverse proxy, sinon n'importe qui peut choisir l'adresse vue par le serveur.
TRUST_PROXY=

# Sur le Pi (Docker) : nom de domaine public, sans https://. Caddy demande le certificat pour ce nom,
# et docker-compose.yml en déduit SITE_URL=https://<SITE_DOMAIN>. Il impose aussi NODE_ENV, HOST, PORT, DB_PATH et TRUST_PROXY :
# leurs valeurs ci-dessus ne servent qu'en local.
SITE_DOMAIN=
