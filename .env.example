# Copier en .env (jamais commité) et remplir.

# Jeton « API Read Access Token » TMDB (themoviedb.org › Paramètres › API).
TMDB_READ_TOKEN=

# Adresse d'écoute. 127.0.0.1 par défaut ; 0.0.0.0 pour tester depuis le téléphone sur le réseau local.
HOST=127.0.0.1
PORT=3000

# Fichier SQLite.
DB_PATH=data/app.sqlite

# development | production | test
NODE_ENV=development
